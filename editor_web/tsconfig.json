{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "sengen-ui": ["submodules/SengenUI/index.ts"],
      "sengen-ui/*": ["submodules/SengenUI/*"],
      "VscodeShellLayout": ["submodules/VscodeShellLayout/src/index.ts"],
      "SengenThree": ["submodules/SengenThree/src/index.ts"],
      "SengenAudio": ["submodules/SengenAudio/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
